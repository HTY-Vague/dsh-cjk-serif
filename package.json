{
  "name": "dsh-cjk-serif",
  "version": "1.3.0",
  "type": "module",
  "description": "General-settings switch that gives Chinese text a serif face, with coarse per-area control.",
  "license": "MIT",
  "author": "HTY-Vague",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HTY-Vague/dsh-cjk-serif.git"
  },
  "homepage": "https://github.com/HTY-Vague/dsh-cjk-serif#readme",
  "bugs": {
    "url": "https://github.com/HTY-Vague/dsh-cjk-serif/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "font",
    "serif",
    "cjk",
    "chinese"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}

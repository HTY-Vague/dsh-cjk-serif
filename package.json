{
  "name": "dsh-cjk-serif",
  "version": "1.4.0",
  "type": "module",
  "description": "General-settings switch that renders Chinese text with a serif face while Latin text and code keep the theme fonts.",
  "license": "MIT",
  "author": "HTY-Vague",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HTY-Vague/dsh-cjk-serif.git"
  },
  "homepage": "https://github.com/HTY-Vague/dsh-cjk-serif#readme",
  "bugs": {
    "url": "https://github.com/HTY-Vague/dsh-cjk-serif/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "font",
    "serif",
    "cjk",
    "chinese"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node tests/variable-filter.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}

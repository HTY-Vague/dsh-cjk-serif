{
  "name": "dsh-cjk-serif",
  "version": "4.0.3",
  "type": "module",
  "description": "Choose the Latin and the Chinese font for DeepSeek Harness text: Inter, Source Serif 4, Noto Serif SC and Noto Sans SC ship with the plugin.",
  "license": "MIT",
  "author": "HTY-Vague",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HTY-Vague/dsh-cjk-serif.git"
  },
  "homepage": "https://github.com/HTY-Vague/dsh-cjk-serif#readme",
  "bugs": {
    "url": "https://github.com/HTY-Vague/dsh-cjk-serif/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "font",
    "typography",
    "serif",
    "latin",
    "cjk",
    "chinese"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "fonts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "fonts": "node scripts/embed-fonts.mjs && node scripts/embed-cjk-fonts.mjs",
    "fonts:check": "node scripts/embed-fonts.mjs --check && node scripts/embed-cjk-fonts.mjs --check",
    "test": "node tests/font-list.test.mjs && node tests/font-route.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
